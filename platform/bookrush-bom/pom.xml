<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.bookrush</groupId>
  <artifactId>bookrush-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>BookRush dependency BOM</name>
  <description>Dependency management only; it contains no classes or runtime configuration</description>
  <properties>
    <spring-boot.version>3.3.5</spring-boot.version>
    <aws.version>2.31.54</aws.version>
    <testcontainers.version>1.20.2</testcontainers.version>
    <springdoc.version>2.6.0</springdoc.version>
    <bookrush.platform.version>0.1.0-SNAPSHOT</bookrush.platform.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bookrush</groupId>
        <artifactId>bookrush-common-core</artifactId>
        <version>${bookrush.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bookrush</groupId>
        <artifactId>bookrush-common-web</artifactId>
        <version>${bookrush.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bookrush</groupId>
        <artifactId>bookrush-security-spring-boot-starter</artifactId>
        <version>${bookrush.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bookrush</groupId>
        <artifactId>bookrush-observability-spring-boot-starter</artifactId>
        <version>${bookrush.platform.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bookrush</groupId>
        <artifactId>bookrush-test-support</artifactId>
        <version>${bookrush.platform.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>

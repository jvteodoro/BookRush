{
  "id": null,
  "uid": "bookrush-storage-redis",
  "title": "BookRush / Storage & Redis",
  "tags": [
    "bookrush",
    "operations",
    "technical-detail"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Redis hit ratio and evictions",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(redis_keyspace_hits_total[5m])) / (sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])))",
          "legendFormat": "hit ratio %"
        },
        {
          "refId": "B",
          "expr": "sum(rate(redis_evicted_keys_total[5m]))",
          "legendFormat": "evictions/s"
        },
        {
          "refId": "C",
          "expr": "redis_connected_clients",
          "legendFormat": "clients"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "S3 operation throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, result) (rate(bookrush_storage_seconds_count{service=~\"$service\"}[5m]))",
          "legendFormat": "{{operation}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 3,
      "title": "S3 operation average latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(bookrush_storage_seconds_sum{service=~\"$service\"}[5m])) / sum by (operation) (rate(bookrush_storage_seconds_count{service=~\"$service\"}[5m]))",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "S3 operation errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(bookrush_storage_seconds_count{service=~\"$service\",result=\"error\"}[5m]))",
          "legendFormat": "{{operation}} errors/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bookrush-prometheus"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  }
}

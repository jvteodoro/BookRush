{
  "id": null,
  "uid": "bookrush-postgresql",
  "title": "BookRush / PostgreSQL",
  "tags": [
    "bookrush",
    "operations",
    "technical-detail"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}"
        },
        {
          "refId": "B",
          "expr": "pg_stat_database_deadlocks",
          "legendFormat": "deadlocks {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "PostgreSQL buffer cache hit ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])))",
          "legendFormat": "cache hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "PostgreSQL commits and rollbacks/s",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m]))",
          "legendFormat": "commits/s"
        },
        {
          "refId": "B",
          "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=\"postgres-exporter\",datname=\"bookrush\"}[5m]))",
          "legendFormat": "rollbacks/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bookrush-prometheus"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}

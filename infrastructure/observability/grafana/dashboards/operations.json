{
  "uid": "bookrush-operations",
  "title": "BookRush / Operations",
  "description": "OP-01..OP-09 and OP-12. Prometheus-backed operational health; Keycloak HTTP outcomes are not user authentication event counts.",
  "tags": ["bookrush", "operations", "versioned"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "30s",
  "templating": {"list": [{"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "query": "label_values(up, service)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": ["$__all"]}}]},
  "panels": [
    {"id": 1, "title": "OP-01 Availability by scrape target", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "min by (job, service, instance) (up{job=~\"bookrush-java|postgres-exporter|redis-exporter|cadvisor|node-exporter|traefik|keycloak\"})", "legendFormat": "{{job}} {{service}} {{instance}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 2, "title": "OP-02 Request throughput by route", "type": "timeseries", "gridPos": {"x": 8, "y": 0, "w": 16, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service, uri) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m]))", "legendFormat": "{{service}} {{uri}} req/s"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 3, "title": "OP-03 HTTP errors by route", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service, uri, status) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\",status=~\"4..|5..\"}[5m]))", "legendFormat": "{{service}} {{uri}} {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 4, "title": "OP-04 Latency p50/p95/p99 by route", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (service, uri, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))", "legendFormat": "p50 {{service}} {{uri}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (service, uri, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))", "legendFormat": "p95 {{service}} {{uri}}"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (service, uri, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))", "legendFormat": "p99 {{service}} {{uri}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 5, "title": "OP-05 JVM memory used", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service) (jvm_memory_used_bytes{job=\"bookrush-java\",service=~\"$service\"})", "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 6, "title": "OP-06 PostgreSQL connections", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}"}, {"refId": "B", "expr": "pg_stat_database_deadlocks", "legendFormat": "deadlocks {{datname}}"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 9, "title": "OP-05 Container CPU", "type": "timeseries", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{image!=\"\",name=~\".*bookrush.*\"}[5m]))", "legendFormat": "{{name}} cores"}], "fieldConfig": {"defaults": {"unit": "cores"}}},
    {"id": 10, "title": "OP-05 Container memory working set", "type": "timeseries", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{image!=\"\",name=~\".*bookrush.*\"})", "legendFormat": "{{name}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
    {"id": 11, "title": "OP-05 Container OOM events", "type": "timeseries", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (name) (increase(container_oom_events_total{image!=\"\",name=~\".*bookrush.*\"}[1h]))", "legendFormat": "{{name}}"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0}}},
    {"id": 7, "title": "OP-07 Redis hit ratio and evictions", "type": "timeseries", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "100 * sum(rate(redis_keyspace_hits_total[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])), 1)", "legendFormat": "hit ratio %"}, {"refId": "B", "expr": "sum(rate(redis_evicted_keys_total[5m]))", "legendFormat": "evictions/s"}, {"refId": "C", "expr": "redis_connected_clients", "legendFormat": "clients"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 19, "title": "OP-05 JVM process CPU", "type": "timeseries", "gridPos": {"x": 0, "y": 48, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service) (rate(process_cpu_seconds_total{job=\"bookrush-java\",service=~\"$service\"}[5m]))", "legendFormat": "{{service}} cores"}], "fieldConfig": {"defaults": {"unit": "cores"}}},
    {"id": 20, "title": "OP-05 JVM live and peak threads", "type": "timeseries", "gridPos": {"x": 6, "y": 48, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "max by (service) (jvm_threads_live_threads{job=\"bookrush-java\",service=~\"$service\"})", "legendFormat": "live {{service}}"}, {"refId": "B", "expr": "max by (service) (jvm_threads_peak_threads{job=\"bookrush-java\",service=~\"$service\"})", "legendFormat": "peak {{service}}"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 21, "title": "OP-05 Average JVM GC pause", "type": "timeseries", "gridPos": {"x": 12, "y": 48, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum{job=\"bookrush-java\",service=~\"$service\"}[5m])) / clamp_min(sum by (service) (rate(jvm_gc_pause_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m])), 0.001)", "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 22, "title": "OP-05 JVM GC pauses/s", "type": "timeseries", "gridPos": {"x": 18, "y": 48, "w": 6, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (service) (rate(jvm_gc_pause_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m]))", "legendFormat": "{{service}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}},
    {"id": 8, "title": "OP-12 Active alerts", "type": "stat", "gridPos": {"x": 0, "y": 40, "w": 12, "h": 5}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "firing alerts"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}},
    {"id": 12, "title": "OP-08 S3 operation throughput", "type": "timeseries", "gridPos": {"x": 0, "y": 56, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation, result) (rate(bookrush_storage_seconds_count{service=\"catalog-service\"}[5m]))", "legendFormat": "{{operation}} {{result}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 13, "title": "OP-08 S3 operation average latency", "type": "timeseries", "gridPos": {"x": 8, "y": 56, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation) (rate(bookrush_storage_seconds_sum{service=\"catalog-service\"}[5m])) / clamp_min(sum by (operation) (rate(bookrush_storage_seconds_count{service=\"catalog-service\"}[5m])), 0.001)", "legendFormat": "{{operation}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 14, "title": "OP-08 S3 operation errors", "type": "timeseries", "gridPos": {"x": 16, "y": 56, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation) (rate(bookrush_storage_seconds_count{service=\"catalog-service\",result=\"error\"}[5m]))", "legendFormat": "{{operation}} errors/s"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 15, "title": "OP-09 Gateway requests and 5xx", "type": "timeseries", "gridPos": {"x": 0, "y": 64, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (code) (rate(traefik_entrypoint_requests_total{job=\"traefik\",entrypoint!=\"metrics\"}[5m]))", "legendFormat": "HTTP {{code}}"}, {"refId": "B", "expr": "sum(rate(traefik_entrypoint_requests_total{job=\"traefik\",entrypoint!=\"metrics\",code=~\"5..\"}[5m]))", "legendFormat": "5xx total"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 16, "title": "OP-09 Gateway latency p95", "type": "timeseries", "gridPos": {"x": 12, "y": 64, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (entrypoint, le) (rate(traefik_entrypoint_request_duration_seconds_bucket{job=\"traefik\",entrypoint!=\"metrics\"}[5m])))", "legendFormat": "{{entrypoint}} p95"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 17, "title": "OP-09 Keycloak HTTP outcomes", "type": "timeseries", "gridPos": {"x": 0, "y": 72, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome, status) (rate(http_server_requests_seconds_count{job=\"keycloak\"}[5m]))", "legendFormat": "{{outcome}} {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"id": 18, "title": "OP-09 Keycloak HTTP latency p95", "type": "timeseries", "gridPos": {"x": 12, "y": 72, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"keycloak\"}[5m])))", "legendFormat": "p95"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id":26,"title":"OP-03 HTTP 5xx ratio by Java service","type":"timeseries","gridPos":{"x":0,"y":80,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"bookrush-prometheus"},"targets":[{"refId":"A","expr":"(100 * sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\",status=~\"5..\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m]))) and on (service) (sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m])) > 0)","legendFormat":"{{service}} 5xx %"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100}}},
    {"id": 24, "title": "OP-06 PostgreSQL buffer cache hit ratio", "type": "timeseries", "gridPos": {"x": 0, "y": 88, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres-exporter\",datname=\"bookrush\"}[5m])), 1)", "legendFormat": "cache hit %"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}},
    {"id": 25, "title": "OP-06 PostgreSQL commits and rollbacks/s", "type": "timeseries", "gridPos": {"x": 12, "y": 88, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=\"postgres-exporter\",datname=\"bookrush\"}[5m]))", "legendFormat": "commits/s"}, {"refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=\"postgres-exporter\",datname=\"bookrush\"}[5m]))", "legendFormat": "rollbacks/s"}], "fieldConfig": {"defaults": {"unit": "ops"}}}
  ]
}

{
  "uid": "bookrush-operations",
  "title": "BookRush / Operations Overview",
  "description": "Sa\u00fade t\u00e9cnica agregada; n\u00e3o representa sucesso funcional de jornada.",
  "tags": [
    "bookrush",
    "operations",
    "versioned"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bookrush-prometheus"
        },
        "query": "label_values(up, service)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Servi\u00e7os com scrape dispon\u00edvel",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (job, service, instance) (up{job=~\"bookrush-java|postgres-exporter|redis-exporter|cadvisor|node-exporter|traefik|keycloak\"})",
          "legendFormat": "{{job}} {{service}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Taxa de erros HTTP 5xx por servi\u00e7o",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\",status=~\"5..\"}[5m])) / sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m]))) and on (service) (sum by (service) (rate(http_server_requests_seconds_count{job=\"bookrush-java\",service=~\"$service\"}[5m])) > 0)",
          "legendFormat": "{{service}} 5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "title": "P95 das requisi\u00e7\u00f5es por servi\u00e7o",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))",
          "legendFormat": "p50 {{service}} {{uri}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))",
          "legendFormat": "p95 {{service}} {{uri}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(http_server_requests_seconds_bucket{job=\"bookrush-java\",service=~\"$service\"}[5m])))",
          "legendFormat": "p99 {{service}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Alertas ativos",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"})",
          "legendFormat": "firing alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Conex\u00f5es e deadlocks PostgreSQL",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}"
        },
        {
          "refId": "B",
          "expr": "pg_stat_database_deadlocks",
          "legendFormat": "deadlocks {{datname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "title": "Estado do caminho do recomendador",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(bookrush_feed_personalized_path_total[5m]))",
          "legendFormat": "serving path {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 7,
      "title": "Fila de processamento por estado",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (bookrush_ingestion_queue_tasks)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Atualiza\u00e7\u00e3o das proje\u00e7\u00f5es",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - bookrush_reporting_projection_last_refresh_timestamp_seconds",
          "legendFormat": "age {{projection}}"
        },
        {
          "refId": "B",
          "expr": "bookrush_reporting_projection_status",
          "legendFormat": "status {{projection}}"
        },
        {
          "refId": "C",
          "expr": "bookrush_reporting_projection_record_count",
          "legendFormat": "records {{projection}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 9,
      "title": "Sa\u00fade t\u00e9cnica n\u00e3o comprova jornadas funcionais",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**Interpreta\u00e7\u00e3o:** `up=1` confirma scrape dispon\u00edvel, n\u00e3o valida login, feed, abertura, progresso nem entrega de eventos. Jornadas sint\u00e9ticas peri\u00f3dicas com popula\u00e7\u00e3o TEST ainda n\u00e3o est\u00e3o instrumentadas."
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 32
      }
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}

    {"id": 22, "title": "FD-07 Ranking stage latency", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(bookrush_feed_stage_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{stage}}"}], "fieldConfig": {"defaults": {"unit": "s"}}},
    {"id": 23, "title": "FD-11 Shadow overlap", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(bookrush_feed_personalized_shadow_overlap_total[5m])) / clamp_min(sum(rate(bookrush_feed_personalized_shadow_compared_total[5m])), 1)", "legendFormat": "overlap / compared"}, {"refId": "B", "expr": "sum(rate(bookrush_feed_personalized_shadow_rank_movement_total[5m]))", "legendFormat": "rank movement"}], "fieldConfig": {"defaults": {"unit": "short"}}},
    {"id": 24, "title": "FD-08/12 Candidate and profile coverage", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "bookrush-prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(bookrush_feed_candidates_total[5m]))", "legendFormat": "candidates {{outcome}}"}, {"refId": "B", "expr": "sum by (outcome) (rate(bookrush_feed_items_total[5m]))", "legendFormat": "items {{outcome}}"}, {"refId": "C", "expr": "sum by (outcome) (rate(bookrush_feed_personalized_profile_confidence_total[5m]))", "legendFormat": "confidence {{outcome}}"}], "fieldConfig": {"defaults": {"unit": "ops"}}}

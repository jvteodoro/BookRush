{
  "uid": "bookrush-pipelines",
  "title": "BookRush / Pipelines & Content",
  "description": "PL-01..PL-06. Uses application/runtime metrics and reporting queue snapshots; unavailable sources are not represented as zero.",
  "tags": [
    "bookrush",
    "pipelines",
    "versioned"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 11,
      "title": "Ingestion stage events",
      "description": "Per-stage and per-attempt event rates; retries may repeat acquired/normalized, so these are not unique books.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(bookrush_ingestion_items_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "items/s"
        }
      }
    },
    {
      "id": 12,
      "title": "Ingestion queue by state",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (bookrush_ingestion_queue_tasks)",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "title": "Oldest pending/retry age",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (bookrush_ingestion_queue_oldest_task_age_seconds{state=~\"PENDING|RETRY_WAIT\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 19,
      "title": "Expired running leases",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bookrush_ingestion_queue_expired_leases{state=\"RUNNING\"})",
          "legendFormat": "expired leases"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 13,
      "title": "Analytics outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(bookrush_analytics_jobs_total[5m]))",
          "legendFormat": "jobs {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (operation) (rate(bookrush_analytics_excerpts_total[5m]))",
          "legendFormat": "excerpts {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 14,
      "title": "Analytics phase latency",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (phase, le) (rate(bookrush_analytics_phase_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 15,
      "title": "Analytics failures",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(bookrush_analytics_failures_total[15m]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 16,
      "title": "Data-source state",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "Counters above are measured Micrometer series. Historical job/item states and storage failures require reporting projections; they are not inferred from container health."
      }
    },
    {
      "id": 17,
      "title": "ML runtime availability and latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "bookrush-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (operation, le) (rate(bookrush_analytics_runtime_request_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "refId": "B",
          "expr": "sum by (model, state) (bookrush_analytics_runtime_model_state)",
          "legendFormat": "{{model}} {{state}}"
        },
        {
          "refId": "C",
          "expr": "bookrush_analytics_runtime_cuda_available",
          "legendFormat": "cuda {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ]
}

logging {
  level = "info"
}

otelcol.receiver.otlp "bookrush" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    logs = [otelcol.exporter.loki.bookrush.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.loki "bookrush" {
  forward_to = [loki.write.bookrush.receiver]
}

loki.write "bookrush" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

# Keycloak is exposed on its own public hostname. TLS is normally terminated
# by this host Nginx and forwarded to the internal Traefik gateway.
server {
    listen 80;
    listen [::]:80;
    server_name keycloak-bookrush.jteodoro.tec.br;

    # After provisioning the certificate, enable HTTPS and redirect port 80:
    # listen 443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/keycloak-bookrush.jteodoro.tec.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/keycloak-bookrush.jteodoro.tec.br/privkey.pem;
    # return 301 https://$host$request_uri;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 120s;
    }
}

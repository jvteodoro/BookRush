
{
  "realm": "bookrush",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,

  "roles": {
    "realm": [
      {
        "name": "READER"
      },
      {
        "name": "OPERATOR"
      },
      {
        "name": "REVIEWER"
      },
      {
        "name": "CLEANUP"
      },
      {
        "name": "ASSET_ADMIN"
      },
      {
        "name": "PUBLISHER",
        "description": "BookRush product role PUBLISHER",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "clientScopes": [
    {
      "name": "bookrush.catalog.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],

  "clients": [
    {
      "clientId": "bookrush-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://bookrush.jteodoro.tec.br/*",
        "http://localhost:18080/*"
      ],
      "webOrigins": [
        "https://bookrush.jteodoro.tec.br",
        "http://localhost:18080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://bookrush.jteodoro.tec.br/*##http://localhost:18080/*"
      },
      "protocolMappers": [
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birthdate",
            "claim.name": "birthdate",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "bookrush-ingestion",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:18090/*"
      ],
      "webOrigins": [
        "http://localhost:18090"
      ],
      "protocolMappers": [
        {
          "name": "bookrush-ingestion-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bookrush-ingestion",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bookrush-catalog-service",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret"
    },
    {
      "clientId": "bookrush-mobile",
      "name": "BookRush Mobile",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "bookrush://callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "bookrush-reader-bff",
      "name": "bookrush-reader-bff",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "bookrush-behavior",
      "name": "bookrush-behavior",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "bookrush-admin-service",
      "name": "BookRush product user management",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "admin-service-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}

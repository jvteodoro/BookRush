{
  "realm": "bookrush",
  "enabled": true,
  "roles": {
    "realm": [
      {"name": "READER"},
      {"name": "OPERATOR"},
      {"name": "REVIEWER"},
      {"name": "CLEANUP"},
      {"name": "ASSET_ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "bookrush-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://bookrush.jteodoro.tec.br/*",
        "http://localhost:18080/*"
      ],
      "webOrigins": [
        "https://bookrush.jteodoro.tec.br",
        "http://localhost:18080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://bookrush.jteodoro.tec.br/*##http://localhost:18080/*"
      }
    },
    {
      "clientId": "bookrush-ingestion",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:18090/*"],
      "webOrigins": ["http://localhost:18090"],
      "protocolMappers": [
        {
          "name": "bookrush-ingestion-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "bookrush-ingestion",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bookrush-catalog-service",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret"
    }
  ]
}

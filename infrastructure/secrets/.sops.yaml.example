# Copie para ~/.config/bookrush/.sops.yaml ou para um arquivo de trabalho fora
# do Git e substitua pelo recipient age da equipe. Nunca versione a chave
# privada. A configuração não contém valores de aplicação.
creation_rules:
  - path_regex: '.*\.env\.enc$'
    age: >-
      age1replace-with-the-team-recipient

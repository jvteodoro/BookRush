{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookRush H/C/A/I/Q annotation row",
  "type": "object",
  "required": ["excerpt_id", "text_sha256", "source_asset_version_id", "annotator_id", "labels"],
  "properties": {
    "excerpt_id": {"type":"string","format":"uuid"},
    "source_asset_version_id": {"type":"string","format":"uuid"},
    "text_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "annotator_id": {"type":"string","minLength":1,"maxLength":160},
    "batch_id": {"type":"string","minLength":1},
    "quality_control": {"type":"boolean"},
    "labels": {
      "type":"object","required":["hook","curiosity","autonomy","intensity","presentation_quality"],
      "additionalProperties":false,
      "properties": {
        "hook":{"type":"integer","minimum":1,"maximum":5},
        "curiosity":{"type":"integer","minimum":1,"maximum":5},
        "autonomy":{"type":"integer","minimum":1,"maximum":5},
        "intensity":{"type":"integer","minimum":1,"maximum":5},
        "presentation_quality":{"type":"integer","minimum":1,"maximum":5}
      }
    },
    "unsure": {"type":"array","items":{"enum":["hook","curiosity","autonomy","intensity","presentation_quality"]},"uniqueItems":true},
    "elapsed_seconds": {"type":"number","minimum":0},
    "rubric_version": {"type":"string","const":"hcaiq-v1"}
  },
  "additionalProperties": false
}

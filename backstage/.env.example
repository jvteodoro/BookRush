# Required only for Docker Compose; generate a local value (openssl rand -hex 32).
BACKSTAGE_POSTGRES_PASSWORD=
# Optional GitHub access; use app-config.local.yaml.example.
GITHUB_TOKEN=
# Production overlays only; see docs/configuration.md.
BACKSTAGE_PUBLIC_URL=https://docs-bookrush.jteodoro.tec.br
BACKSTAGE_CATALOG_URL=https://github.com/jvteodoro/BookRush/blob/main/catalog-info.yaml
POSTGRES_HOST=backstage-postgres
POSTGRES_USER=backstage
POSTGRES_PASSWORD=
TECHDOCS_BUCKET=bookrush-techdocs
AWS_REGION=us-east-1
TECHDOCS_S3_ENDPOINT=http://seaweedfs:8333
TECHDOCS_ACCESS_KEY=
TECHDOCS_SECRET_KEY=
# Production OIDC only; local development uses the guest provider.
AUTH_OIDC_METADATA_URL=https://keycloak.example/realms/bookrush/.well-known/openid-configuration
AUTH_OIDC_CLIENT_ID=bookrush-backstage
AUTH_OIDC_CLIENT_SECRET=
AUTH_SESSION_SECRET=

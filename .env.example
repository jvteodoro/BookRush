# Docker image names used by Compose
BACKEND_IMAGE=bookrush/catalog-service:local
FRONTEND_IMAGE=bookrush/frontend:local

# Host ports are bound only to loopback; Nginx is the public entry point.
BOOKRUSH_FRONTEND_PORT=18080
BOOKRUSH_JENKINS_PORT=18082
BOOKRUSH_PGADMIN_PORT=18083
# Absolute host path used by the Jenkins-launched Compose deploy for the
# Traefik dynamic configuration file.
# Filled automatically by infrastructure/bootstrap/configure-ubuntu.sh.
BOOKRUSH_REPO_ROOT=

# Public URLs used in redirects and OIDC metadata. Change them for another host.
BOOKRUSH_PUBLIC_URL=http://localhost:18080
KEYCLOAK_PUBLIC_URL=http://localhost:18088
INGESTION_PUBLIC_URL=http://localhost:18090/ingestion
BACKSTAGE_PUBLIC_URL=http://localhost:17007

# Local database credentials only. Do not reuse outside development.
POSTGRES_DB=bookrush
POSTGRES_USER=bookrush
POSTGRES_PASSWORD=bookrush

# pgAdmin administrator. Set a strong, unique password in .env.
PGADMIN_DEFAULT_EMAIL=admin@bookrush.jteodoro.tec.br
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password

# Execute `stat -c '%g' /var/run/docker.sock` on Linux before enabling Jenkins.
DOCKER_GID=999

# Development examples only: replace credentials before exposing any endpoint.
STORAGE_ACCESS_KEY=bookrush-dev
STORAGE_SECRET_KEY=bookrush-development-secret-change-me
ASSET_ADMIN_TOKEN=bookrush-development-admin-token-change-me
CANONICAL_SERVICE_TOKEN=
INGESTION_ASSET_TOKEN=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password
BOOKRUSH_S3_PORT=18333
STORAGE_PUBLIC_ENDPOINT=http://localhost:18333
STORAGE_BUCKET_SOURCE=books-source
STORAGE_BUCKET_PUBLIC=books-public
STORAGE_BUCKET_PROCESSING=books-processing
STORAGE_BUCKET_ML=books-ml
STORAGE_BUCKET_RAW=books-raw

# Backstage uses the same PostgreSQL password by default, but may be separate.
BACKSTAGE_POSTGRES_PASSWORD=bookrush-backstage-development-password

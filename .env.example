# Docker image names used by Compose
BACKEND_IMAGE=bookrush/catalog-service:local
FRONTEND_IMAGE=bookrush/frontend:local

# Host ports are bound only to loopback; Nginx is the public entry point.
BOOKRUSH_FRONTEND_PORT=18080
BOOKRUSH_JENKINS_PORT=18082
BOOKRUSH_PGADMIN_PORT=18083
# Absolute host path used by the Jenkins-launched Compose deploy for the
# Traefik dynamic configuration file.
# Filled automatically by infrastructure/bootstrap/configure-ubuntu.sh.
BOOKRUSH_REPO_ROOT=

# Public URLs used in redirects and OIDC metadata. Change them for another host.
BOOKRUSH_PUBLIC_URL=http://localhost:18080
KEYCLOAK_PUBLIC_URL=http://localhost:18088
INGESTION_PUBLIC_URL=http://localhost:18090/ingestion
BACKSTAGE_PUBLIC_URL=http://localhost:17007

# Local database credentials only. Do not reuse outside development.
POSTGRES_DB=bookrush
POSTGRES_USER=bookrush
POSTGRES_PASSWORD=bookrush

# pgAdmin administrator. Set a strong, unique password in .env.
PGADMIN_DEFAULT_EMAIL=admin@bookrush.jteodoro.tec.br
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password

# Execute `stat -c '%g' /var/run/docker.sock` on Linux before enabling Jenkins.
DOCKER_GID=999

# Development examples only: replace credentials before exposing any endpoint.
STORAGE_ACCESS_KEY=bookrush-dev
STORAGE_SECRET_KEY=bookrush-development-secret-change-me
ASSET_ADMIN_TOKEN=bookrush-development-admin-token-change-me
CATALOG_OIDC_ENABLED=true
CATALOG_OIDC_ISSUER=http://localhost:18088/realms/bookrush-platform
CATALOG_OIDC_JWK_SET_URI=http://keycloak:8080/realms/bookrush-platform/protocol/openid-connect/certs
CATALOG_OIDC_AUDIENCE=bookrush-catalog-admin
CATALOG_SECURITY_LEGACY_STATIC_ENABLED=false
CANONICAL_SERVICE_TOKEN=
INGESTION_ASSET_TOKEN=
INGESTION_OIDC_S2S_ENABLED=false
INGESTION_LEGACY_STATIC_TOKENS_ENABLED=false
INGESTION_OIDC_ISSUER=http://localhost:18088/realms/bookrush-platform
INGESTION_OIDC_AUDIENCE=bookrush-ingestion
INGESTION_OIDC_TOKEN_URI=http://localhost:18088/realms/bookrush-platform/protocol/openid-connect/token
INGESTION_CANONICAL_CLIENT_ID=
INGESTION_CANONICAL_CLIENT_SECRET=
INGESTION_CANONICAL_SCOPE=bookrush.catalog.write
INGESTION_ASSET_CLIENT_ID=
INGESTION_ASSET_CLIENT_SECRET=
INGESTION_ASSET_SCOPE=bookrush.assets.write
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password
# Reconcile incremental do Keycloak; nunca use o bootstrap admin como segredo
# recorrente em produção. A variável real fica somente no .env protegido.
KEYCLOAK_CONFIG_CLI_ADMIN_USER=admin
KEYCLOAK_CONFIG_CLI_ADMIN_PASSWORD=
# Optional client secrets injected only during reconcile; keep them in SOPS.
JENKINS_OIDC_CLIENT_SECRET=
BACKSTAGE_OIDC_CLIENT_SECRET=
INGESTION_ADMIN_CLIENT_SECRET=
JENKINS_OIDC_CLIENT_ID=bookrush-jenkins
JENKINS_OIDC_WELL_KNOWN_URL=https://keycloak-bookrush.jteodoro.tec.br/realms/bookrush-platform/.well-known/openid-configuration
BACKSTAGE_OIDC_ENABLED=false
AUTH_OIDC_METADATA_URL=https://keycloak-bookrush.jteodoro.tec.br/realms/bookrush-platform/.well-known/openid-configuration
AUTH_OIDC_CLIENT_ID=bookrush-backstage
AUTH_OIDC_CLIENT_SECRET=
AUTH_SESSION_SECRET=
BOOKRUSH_S3_PORT=18333
STORAGE_PUBLIC_ENDPOINT=http://localhost:18333
SEAWEEDFS_OIDC_CLIENT_ID=bookrush-seaweedfs
SEAWEEDFS_OIDC_CLIENT_SECRET=
SEAWEEDFS_OIDC_ISSUER_URL=https://keycloak-bookrush.jteodoro.tec.br/realms/bookrush-platform
SEAWEEDFS_OIDC_REDIRECT_URL=https://seaweedfs-bookrush.jteodoro.tec.br/oauth2/callback
# Generate a 32-byte base64 value, for example: openssl rand -base64 32
SEAWEEDFS_OAUTH2_COOKIE_SECRET=
STORAGE_BUCKET_SOURCE=books-source
STORAGE_BUCKET_PUBLIC=books-public
STORAGE_BUCKET_PROCESSING=books-processing
STORAGE_BUCKET_ML=books-ml
STORAGE_BUCKET_RAW=books-raw

# Backstage uses the same PostgreSQL password by default, but may be separate.
BACKSTAGE_POSTGRES_PASSWORD=bookrush-backstage-development-password
